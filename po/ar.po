msgid "PROJECT EON"
msgstr "بروجكت إيون"

msgid "SELECT GAME   |   UP/DOWN: PLATFORM   |   D: DATA SCAN   |   F1: ORIGINAL / MODERN   |   ESC: QUIT"
msgstr "اختر اللعبة   |   أعلى/أسفل: المنصة   |   D: فحص البيانات   |   F1: أصلي / حديث   |   ESC: خروج"
msgid "VERIFIED ORIGINAL DATA"
msgstr "بيانات أصلية تم التحقق منها"
msgid "ORIGINAL DATA NOT FOUND"
msgstr "لم يتم العثور على البيانات الأصلية"
msgid "SCANNING ORIGINAL DATA..."
msgstr "جارٍ فحص البيانات الأصلية..."
msgid "ENTER / CLICK: START"
msgstr "ENTER / نقرة: ابدأ"
msgid "PLATFORM:"
msgstr "المنصة:"
msgid "AUTO"
msgstr "تلقائي"
msgid "LAUNCH REQUEST ACCEPTED"
msgstr "تم قبول طلب التشغيل"
msgid "PLATFORM: "
msgstr "المنصة: "
msgid "DATA SCANNER (content hashes, read-only)"
msgstr "ماسح البيانات (تجزئات المحتوى، للقراءة فقط)"
msgid "Files scanned: "
msgstr "الملفات المفحوصة: "
msgid "Complete. Only hash-verified original releases are selectable."
msgstr "اكتمل. لا يمكن اختيار إلا الإصدارات الأصلية المتحقق منها بالتجزئة."
msgid "Scanning in progress. Press D to hide this progress panel."
msgstr "الفحص جارٍ. اضغط D لإخفاء لوحة التقدم هذه."
msgid "ESC: QUIT"
msgstr "ESC: خروج"
msgid "ESC: BACK TO MENU"
msgstr "ESC: العودة إلى القائمة"
msgid "Game: "
msgstr "اللعبة: "
msgid "Platform: "
msgstr "المنصة: "
msgid "Presentation: Modern"
msgstr "العرض: حديث"
msgid "Presentation: Original"
msgstr "العرض: أصلي"
msgid "Original data is present and selected."
msgstr "البيانات الأصلية متوفرة ومحددة."
msgid "The simulation is incomplete; no synthetic substitute will run."
msgstr "المحاكاة غير مكتملة؛ لن يعمل أي بديل اصطناعي."

msgid "AUTHENTIC TITLE STAGE READY"
msgstr "مرحلة العنوان الأصلية جاهزة"
msgid "TITLE-STAGE EXECUTION IS NOT YET RECOVERED; NO TITLE SCREEN IS FABRICATED"
msgstr "لم تُستعَد بعد عملية تنفيذ مرحلة العنوان؛ لا تُنشأ أي شاشة عنوان مصطنعة"
msgid "ORIGINAL TITLE STAGE SHA-256: "
msgstr "SHA-256 لمرحلة العنوان الأصلية: "
msgid "AUTHENTIC DOS HANDOFF - TITLES.EXE -> 2200ad.exe; GX.LIB IMG00 -> IMG01"
msgstr "تسليم DOS أصيل - TITLES.EXE -> 2200ad.exe؛ GX.LIB IMG00 -> IMG01"
msgid "ORIGINAL GX CANVAS + READ-ONLY 2200SAVE.I POSITIONAL TABLE"
msgstr "لوحة GX الأصلية + جدول موضعي لـ 2200SAVE.I للقراءة فقط"
msgid "AUTHENTIC SPANISH DOS TITLE - FAT12 TITLE.LIB P00 + VGA RGB6 DAC"
msgstr "عنوان DOS إسباني أصيل - FAT12 TITLE.LIB P00 + VGA RGB6 DAC"
msgid "EXECUTABLE HANDOFF NOT YET RECOVERED; NO ENGLISH STATE IS SUBSTITUTED"
msgstr "لم تُستعَد عملية تسليم الملف التنفيذي بعد؛ لا تُستبدل أي حالة إنجليزية"
msgid "AUTHENTIC DOS TITLE - P00 INDICES + VGA RGB6 DAC"
msgstr "عنوان DOS أصيل - فهارس P00 + VGA RGB6 DAC"
msgid "PRESS ANY KEY: ORIGINAL INT 21h/AH=06h TITLE HANDOFF"
msgstr "اضغط أي مفتاح: تسليم العنوان الأصلي INT 21h/AH=06h"
msgid "RECOVERED POSITIONAL WORDS ONLY; NO INFERRED GAME SEMANTICS"
msgstr "كلمات موضعية مستعادة فقط؛ لا دلالات لعبة مستنتجة"
msgid "VERIFIED NATIVE MILLENNIUM DATA - NO DOS RESOURCE SUBSTITUTION"
msgstr "بيانات Millennium الأصلية المتحقق منها - لا استبدال لموارد DOS"
msgid "INTERACTIVE AMIGA/ATARI ST FLOW IS NOT YET RECOVERED."
msgstr "لم يُستعَد بعد التدفق التفاعلي لـ Amiga/Atari ST."
msgid "NO SYNTHETIC SCREEN OR STATE WILL RUN FOR THIS PLATFORM."
msgstr "لن تعمل أي شاشة أو حالة اصطناعية لهذه المنصة."
msgid "VERIFIED DEUTEROS ATARI ST MEDIA - PROTECTED BOOT CHAIN ONLY"
msgstr "وسائط Deuteros Atari ST المتحقق منها - سلسلة إقلاع محمية فقط"
msgid "INTERACTIVE ATARI ST PRESENTATION IS NOT YET RECOVERED."
msgstr "لم يُستعَد بعد العرض التفاعلي لـ Atari ST."
msgid "NO AMIGA PREVIEW OR SYNTHETIC STATE WILL RUN FOR THIS PLATFORM."
msgstr "لن تعمل معاينة Amiga ولا أي حالة اصطناعية لهذه المنصة."
msgid "AUTHENTIC AMIGA OPENING - ORIGINAL CHANNEL PROGRAM + PALETTE"
msgstr "افتتاحية Amiga أصيلة - برنامج القناة الأصلي + لوحة الألوان"
msgid "HOLD SPACE / ENTER: ORIGINAL INPUT SIGNAL"
msgstr "اضغط مطولاً SPACE / ENTER: إشارة الإدخال الأصلية"
msgid "PAULA: ORIGINAL PCM + PERIOD + VOLUME (FIRST DMA PASS)"
msgstr "PAULA: PCM الأصلي + الفترة + مستوى الصوت (أول تمرير DMA)"
msgid "ORIGINAL TITLE HANDOFF: RESOURCE 0x"
msgstr "تسليم العنوان الأصلي: المورد 0x"
msgid "ORIGINAL $20580 STREAM: +0x"
msgstr "دفق $20580 الأصلي: +0x"

msgid "MODERN GRAPHICS SETTINGS"
msgstr "إعدادات الرسوم الحديثة"

msgid "F10: CLOSE"
msgstr "F10: إغلاق"

msgid "LEFT/RIGHT: CHANGE"
msgstr "يسار/يمين: تغيير"

msgid "SMOOTH SCALING"
msgstr "تحجيم سلس"

msgid "SCANLINES"
msgstr "خطوط المسح"

msgid "MODERN FRAME"
msgstr "إطار حديث"

msgid "ON"
msgstr "تشغيل"

msgid "OFF"
msgstr "إيقاف"

msgid "SETTINGS APPLY TO SDL RENDERING ONLY."
msgstr "تنطبق الإعدادات على عرض SDL فقط."

msgid "UP/DOWN: SELECT   LEFT/RIGHT: CHANGE   F10: CLOSE"
msgstr "أعلى/أسفل: اختيار   يسار/يمين: تغيير   F10: إغلاق"

msgid "OUTPUT RESOLUTION"
msgstr "دقة الإخراج"
msgid "ASPECT RATIO"
msgstr "نسبة العرض إلى الارتفاع"
msgid "ORIGINAL 4:3"
msgstr "الأصلية 4:3"
msgid "SQUARE PIXELS 8:5"
msgstr "بكسلات مربعة 8:5"
msgid "WIDESCREEN 16:9"
msgstr "شاشة عريضة 16:9"
