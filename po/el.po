msgid "PROJECT EON"
msgstr "PROJECT EON"

msgid "SELECT GAME   |   UP/DOWN: PLATFORM   |   D: DATA SCAN   |   F1: ORIGINAL / MODERN   |   ESC: QUIT"
msgstr "ΕΠΙΛΟΓΗ ΠΑΙΧΝΙΔΙΟΥ   |   ΠΑΝΩ/ΚΑΤΩ: ΠΛΑΤΦΟΡΜΑ   |   D: ΕΛΕΓΧΟΣ ΔΕΔΟΜΕΝΩΝ   |   F1: ΠΡΩΤΟΤΥΠΟ / ΣΥΓΧΡΟΝΟ   |   ESC: ΕΞΟΔΟΣ"
msgid "VERIFIED ORIGINAL DATA"
msgstr "ΕΠΑΛΗΘΕΥΜΕΝΑ ΠΡΩΤΟΤΥΠΑ ΔΕΔΟΜΕΝΑ"
msgid "ORIGINAL DATA NOT FOUND"
msgstr "ΔΕΝ ΒΡΕΘΗΚΑΝ ΠΡΩΤΟΤΥΠΑ ΔΕΔΟΜΕΝΑ"
msgid "SCANNING ORIGINAL DATA..."
msgstr "ΕΛΕΓΧΟΣ ΠΡΩΤΟΤΥΠΩΝ ΔΕΔΟΜΕΝΩΝ..."
msgid "ENTER / CLICK: START"
msgstr "ENTER / ΚΛΙΚ: ΕΚΚΙΝΗΣΗ"
msgid "PLATFORM:"
msgstr "ΠΛΑΤΦΟΡΜΑ:"
msgid "AUTO"
msgstr "ΑΥΤΟΜΑΤΟ"
msgid "LAUNCH REQUEST ACCEPTED"
msgstr "ΤΟ ΑΙΤΗΜΑ ΕΚΚΙΝΗΣΗΣ ΕΓΙΝΕ ΔΕΚΤΟ"
msgid "PLATFORM: "
msgstr "ΠΛΑΤΦΟΡΜΑ: "
msgid "DATA SCANNER (content hashes, read-only)"
msgstr "ΣΑΡΩΤΗΣ ΔΕΔΟΜΕΝΩΝ (κατακερματισμοί περιεχομένου, μόνο για ανάγνωση)"
msgid "Files scanned: "
msgstr "Αρχεία που σαρώθηκαν: "
msgid "Complete. Only hash-verified original releases are selectable."
msgstr "Ολοκληρώθηκε. Επιλέγονται μόνο πρωτότυπες εκδόσεις επαληθευμένες με κατακερματισμό."
msgid "Scanning in progress. Press D to hide this progress panel."
msgstr "Η σάρωση βρίσκεται σε εξέλιξη. Πατήστε D για απόκρυψη του πίνακα προόδου."
msgid "ESC: QUIT"
msgstr "ESC: ΕΞΟΔΟΣ"
msgid "ESC: BACK TO MENU"
msgstr "ESC: ΠΙΣΩ ΣΤΟ ΜΕΝΟΥ"
msgid "Game: "
msgstr "Παιχνίδι: "
msgid "Platform: "
msgstr "Πλατφόρμα: "
msgid "Presentation: Modern"
msgstr "Παρουσίαση: Σύγχρονη"
msgid "Presentation: Original"
msgstr "Παρουσίαση: Πρωτότυπη"
msgid "Original data is present and selected."
msgstr "Τα πρωτότυπα δεδομένα είναι διαθέσιμα και επιλεγμένα."
msgid "The simulation is incomplete; no synthetic substitute will run."
msgstr "Η προσομοίωση είναι ελλιπής· δεν θα εκτελεστεί κανένα συνθετικό υποκατάστατο."

msgid "AUTHENTIC TITLE STAGE READY"
msgstr "Η ΑΥΘΕΝΤΙΚΗ ΦΑΣΗ ΤΙΤΛΟΥ ΕΙΝΑΙ ΕΤΟΙΜΗ"
msgid "TITLE-STAGE EXECUTION IS NOT YET RECOVERED; NO TITLE SCREEN IS FABRICATED"
msgstr "Η ΕΚΤΕΛΕΣΗ ΤΗΣ ΦΑΣΗΣ ΤΙΤΛΟΥ ΔΕΝ ΕΧΕΙ ΑΚΟΜΗ ΑΝΑΚΤΗΘΕΙ· ΔΕΝ ΚΑΤΑΣΚΕΥΑΖΕΤΑΙ ΤΕΧΝΗΤΑ ΚΑΜΙΑ ΟΘΟΝΗ ΤΙΤΛΟΥ"
msgid "ORIGINAL TITLE STAGE SHA-256: "
msgstr "SHA-256 ΤΗΣ ΠΡΩΤΟΤΥΠΗΣ ΦΑΣΗΣ ΤΙΤΛΟΥ: "
msgid "AUTHENTIC DOS HANDOFF - TITLES.EXE -> 2200ad.exe; GX.LIB IMG00 -> IMG01"
msgstr "ΑΥΘΕΝΤΙΚΗ ΠΑΡΑΔΟΣΗ DOS - TITLES.EXE -> 2200ad.exe· GX.LIB IMG00 -> IMG01"
msgid "ORIGINAL GX CANVAS + READ-ONLY 2200SAVE.I POSITIONAL TABLE"
msgstr "ΑΡΧΙΚΟΣ ΚΑΜΒΑΣ GX + ΠΙΝΑΚΑΣ ΘΕΣΕΩΝ 2200SAVE.I ΜΟΝΟ ΓΙΑ ΑΝΑΓΝΩΣΗ"
msgid "AUTHENTIC SPANISH DOS TITLE - FAT12 TITLE.LIB P00 + VGA RGB6 DAC"
msgstr "ΑΥΘΕΝΤΙΚΟΣ ΙΣΠΑΝΙΚΟΣ ΤΙΤΛΟΣ DOS - FAT12 TITLE.LIB P00 + VGA RGB6 DAC"
msgid "EXECUTABLE HANDOFF NOT YET RECOVERED; NO ENGLISH STATE IS SUBSTITUTED"
msgstr "Η ΠΑΡΑΔΟΣΗ ΤΟΥ ΕΚΤΕΛΕΣΙΜΟΥ ΔΕΝ ΕΧΕΙ ΑΚΟΜΗ ΑΝΑΚΤΗΘΕΙ· ΚΑΜΙΑ ΑΓΓΛΙΚΗ ΚΑΤΑΣΤΑΣΗ ΔΕΝ ΥΠΟΚΑΘΙΣΤΑΤΑΙ"
msgid "AUTHENTIC DOS TITLE - P00 INDICES + VGA RGB6 DAC"
msgstr "ΑΥΘΕΝΤΙΚΟΣ ΤΙΤΛΟΣ DOS - ΔΕΙΚΤΕΣ P00 + VGA RGB6 DAC"
msgid "PRESS ANY KEY: ORIGINAL INT 21h/AH=06h TITLE HANDOFF"
msgstr "ΠΑΤΗΣΤΕ ΟΠΟΙΟΔΗΠΟΤΕ ΠΛΗΚΤΡΟ: ΑΡΧΙΚΗ ΠΑΡΑΔΟΣΗ ΤΙΤΛΟΥ INT 21h/AH=06h"
msgid "RECOVERED POSITIONAL WORDS ONLY; NO INFERRED GAME SEMANTICS"
msgstr "ΜΟΝΟ ΑΝΑΚΤΗΜΕΝΕΣ ΛΕΞΕΙΣ ΘΕΣΗΣ· ΚΑΜΙΑ ΣΥΝΑΓΟΜΕΝΗ ΣΗΜΑΣΙΟΛΟΓΙΑ ΠΑΙΧΝΙΔΙΟΥ"
msgid "VERIFIED NATIVE MILLENNIUM DATA - NO DOS RESOURCE SUBSTITUTION"
msgstr "ΕΠΑΛΗΘΕΥΜΕΝΑ ΕΓΓΕΝΗ ΔΕΔΟΜΕΝΑ MILLENNIUM - ΧΩΡΙΣ ΥΠΟΚΑΤΑΣΤΑΣΗ ΠΟΡΩΝ DOS"
msgid "INTERACTIVE AMIGA/ATARI ST FLOW IS NOT YET RECOVERED."
msgstr "Η ΔΙΑΔΡΟΜΗ ΑΛΛΗΛΕΠΙΔΡΑΣΗΣ AMIGA/ATARI ST ΔΕΝ ΕΧΕΙ ΑΚΟΜΗ ΑΝΑΚΤΗΘΕΙ."
msgid "NO SYNTHETIC SCREEN OR STATE WILL RUN FOR THIS PLATFORM."
msgstr "ΚΑΜΙΑ ΣΥΝΘΕΤΙΚΗ ΟΘΟΝΗ Η ΚΑΤΑΣΤΑΣΗ ΔΕΝ ΘΑ ΕΚΤΕΛΕΣΤΕΙ ΓΙΑ ΑΥΤΗΝ ΤΗΝ ΠΛΑΤΦΟΡΜΑ."
msgid "VERIFIED DEUTEROS ATARI ST MEDIA - PROTECTED BOOT CHAIN ONLY"
msgstr "ΕΠΑΛΗΘΕΥΜΕΝΑ ΜΕΣΑ DEUTEROS ATARI ST - ΜΟΝΟ ΠΡΟΣΤΑΤΕΥΜΕΝΗ ΑΛΥΣΙΔΑ ΕΚΚΙΝΗΣΗΣ"
msgid "INTERACTIVE ATARI ST PRESENTATION IS NOT YET RECOVERED."
msgstr "Η ΑΛΛΗΛΕΠΙΔΡΑΣΤΙΚΗ ΠΑΡΟΥΣΙΑΣΗ ATARI ST ΔΕΝ ΕΧΕΙ ΑΚΟΜΗ ΑΝΑΚΤΗΘΕΙ."
msgid "NO AMIGA PREVIEW OR SYNTHETIC STATE WILL RUN FOR THIS PLATFORM."
msgstr "ΚΑΜΙΑ ΠΡΟΕΠΙΣΚΟΠΗΣΗ AMIGA Η ΣΥΝΘΕΤΙΚΗ ΚΑΤΑΣΤΑΣΗ ΔΕΝ ΘΑ ΕΚΤΕΛΕΣΤΕΙ ΓΙΑ ΑΥΤΗΝ ΤΗΝ ΠΛΑΤΦΟΡΜΑ."
msgid "AUTHENTIC AMIGA OPENING - ORIGINAL CHANNEL PROGRAM + PALETTE"
msgstr "ΑΥΘΕΝΤΙΚΗ ΕΙΣΑΓΩΓΗ AMIGA - ΑΡΧΙΚΟ ΠΡΟΓΡΑΜΜΑ ΚΑΝΑΛΙΟΥ + ΠΑΛΕΤΑ"
msgid "HOLD SPACE / ENTER: ORIGINAL INPUT SIGNAL"
msgstr "ΚΡΑΤΗΣΤΕ SPACE / ENTER: ΑΡΧΙΚΟ ΣΗΜΑ ΕΙΣΟΔΟΥ"
msgid "PAULA: ORIGINAL PCM + PERIOD + VOLUME (FIRST DMA PASS)"
msgstr "PAULA: ΑΡΧΙΚΟ PCM + ΠΕΡΙΟΔΟΣ + ΕΝΤΑΣΗ (ΠΡΩΤΟ ΠΕΡΑΣΜΑ DMA)"
msgid "ORIGINAL TITLE HANDOFF: RESOURCE 0x"
msgstr "ΑΡΧΙΚΗ ΠΑΡΑΔΟΣΗ ΤΙΤΛΟΥ: ΠΟΡΟΣ 0x"
msgid "ORIGINAL $20580 STREAM: +0x"
msgstr "ΑΡΧΙΚΗ ΡΟΗ $20580: +0x"

