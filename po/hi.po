msgid "OUTPUT RESOLUTION"
msgstr "आउटपुट रिज़ॉल्यूशन"
msgid "ASPECT RATIO"
msgstr "आस्पेक्ट अनुपात"
msgid "ORIGINAL 4:3"
msgstr "मूल 4:3"
msgid "SQUARE PIXELS 8:5"
msgstr "वर्ग पिक्सेल 8:5"
msgid "WIDESCREEN 16:9"
msgstr "वाइडस्क्रीन 16:9"

msgid "PROJECT EON"
msgstr "प्रोजेक्ट इऑन"

msgid "SELECT GAME   |   UP/DOWN: PLATFORM   |   D: DATA SCAN   |   F1: ORIGINAL / MODERN   |   ESC: QUIT"
msgstr "गेम चुनें   |   ऊपर/नीचे: प्लेटफ़ॉर्म   |   D: डेटा जाँच   |   F1: मूल / आधुनिक   |   ESC: बाहर निकलें"
msgid "VERIFIED ORIGINAL DATA"
msgstr "सत्यापित मूल डेटा"
msgid "ORIGINAL DATA NOT FOUND"
msgstr "मूल डेटा नहीं मिला"
msgid "SCANNING ORIGINAL DATA..."
msgstr "मूल डेटा जाँचा जा रहा है..."
msgid "ENTER / CLICK: START"
msgstr "ENTER / क्लिक: शुरू करें"
msgid "PLATFORM:"
msgstr "प्लेटफ़ॉर्म:"
msgid "AUTO"
msgstr "स्वचालित"
msgid "LAUNCH REQUEST ACCEPTED"
msgstr "प्रारंभ अनुरोध स्वीकार किया गया"
msgid "PLATFORM: "
msgstr "प्लेटफ़ॉर्म: "
msgid "DATA SCANNER (content hashes, read-only)"
msgstr "डेटा स्कैनर (सामग्री हैश, केवल-पठन)"
msgid "Files scanned: "
msgstr "स्कैन की गई फ़ाइलें: "
msgid "Complete. Only hash-verified original releases are selectable."
msgstr "पूर्ण। केवल हैश से सत्यापित मूल रिलीज़ ही चुनी जा सकती हैं।"
msgid "Scanning in progress. Press D to hide this progress panel."
msgstr "स्कैन चल रहा है। इस प्रगति पैनल को छिपाने के लिए D दबाएँ।"
msgid "ESC: QUIT"
msgstr "ESC: बाहर निकलें"
msgid "ESC: BACK TO MENU"
msgstr "ESC: मेनू पर वापस"
msgid "Game: "
msgstr "गेम: "
msgid "Platform: "
msgstr "प्लेटफ़ॉर्म: "
msgid "Presentation: Modern"
msgstr "प्रस्तुति: आधुनिक"
msgid "Presentation: Original"
msgstr "प्रस्तुति: मूल"
msgid "Original data is present and selected."
msgstr "मूल डेटा मौजूद है और चुना गया है।"
msgid "The simulation is incomplete; no synthetic substitute will run."
msgstr "सिमुलेशन अधूरा है; कोई कृत्रिम विकल्प नहीं चलाया जाएगा।"

msgid "AUTHENTIC TITLE STAGE READY"
msgstr "प्रामाणिक शीर्षक चरण तैयार है"
msgid "TITLE-STAGE EXECUTION IS NOT YET RECOVERED; NO TITLE SCREEN IS FABRICATED"
msgstr "शीर्षक-चरण निष्पादन अभी तक पुनर्प्राप्त नहीं हुआ है; कोई कृत्रिम शीर्षक स्क्रीन नहीं बनाई गई है"
msgid "ORIGINAL TITLE STAGE SHA-256: "
msgstr "मूल शीर्षक चरण का SHA-256: "
msgid "AUTHENTIC DOS HANDOFF - TITLES.EXE -> 2200ad.exe; GX.LIB IMG00 -> IMG01"
msgstr "प्रामाणिक DOS हस्तांतरण - TITLES.EXE -> 2200ad.exe; GX.LIB IMG00 -> IMG01"
msgid "ORIGINAL GX CANVAS + READ-ONLY 2200SAVE.I POSITIONAL TABLE"
msgstr "मूल GX कैनवास + केवल-पठन 2200SAVE.I स्थितीय तालिका"
msgid "AUTHENTIC SPANISH DOS TITLE - FAT12 TITLE.LIB P00 + VGA RGB6 DAC"
msgstr "प्रामाणिक स्पेनी DOS शीर्षक - FAT12 TITLE.LIB P00 + VGA RGB6 DAC"
msgid "EXECUTABLE HANDOFF NOT YET RECOVERED; NO ENGLISH STATE IS SUBSTITUTED"
msgstr "निष्पादनयोग्य हस्तांतरण अभी पुनर्प्राप्त नहीं हुआ; किसी अंग्रेज़ी स्थिति को प्रतिस्थापित नहीं किया गया है"
msgid "AUTHENTIC DOS TITLE - P00 INDICES + VGA RGB6 DAC"
msgstr "प्रामाणिक DOS शीर्षक - P00 सूचकांक + VGA RGB6 DAC"
msgid "PRESS ANY KEY: ORIGINAL INT 21h/AH=06h TITLE HANDOFF"
msgstr "कोई भी कुंजी दबाएँ: मूल INT 21h/AH=06h शीर्षक हस्तांतरण"
msgid "RECOVERED POSITIONAL WORDS ONLY; NO INFERRED GAME SEMANTICS"
msgstr "केवल पुनर्प्राप्त स्थितीय शब्द; अनुमानित गेम अर्थ नहीं"
msgid "VERIFIED NATIVE MILLENNIUM DATA - NO DOS RESOURCE SUBSTITUTION"
msgstr "सत्यापित मूल Millennium डेटा - कोई DOS संसाधन प्रतिस्थापन नहीं"
msgid "INTERACTIVE AMIGA/ATARI ST FLOW IS NOT YET RECOVERED."
msgstr "इंटरैक्टिव Amiga/Atari ST प्रवाह अभी तक पुनर्प्राप्त नहीं हुआ है।"
msgid "NO SYNTHETIC SCREEN OR STATE WILL RUN FOR THIS PLATFORM."
msgstr "इस प्लेटफ़ॉर्म के लिए कोई कृत्रिम स्क्रीन या स्थिति नहीं चलाई जाएगी।"
msgid "VERIFIED DEUTEROS ATARI ST MEDIA - PROTECTED BOOT CHAIN ONLY"
msgstr "सत्यापित Deuteros Atari ST मीडिया - केवल संरक्षित बूट शृंखला"
msgid "INTERACTIVE ATARI ST PRESENTATION IS NOT YET RECOVERED."
msgstr "इंटरैक्टिव Atari ST प्रस्तुति अभी तक पुनर्प्राप्त नहीं हुई है।"
msgid "NO AMIGA PREVIEW OR SYNTHETIC STATE WILL RUN FOR THIS PLATFORM."
msgstr "इस प्लेटफ़ॉर्म के लिए कोई Amiga पूर्वावलोकन या कृत्रिम स्थिति नहीं चलाई जाएगी।"
msgid "AUTHENTIC AMIGA OPENING - ORIGINAL CHANNEL PROGRAM + PALETTE"
msgstr "प्रामाणिक Amiga आरंभ - मूल चैनल प्रोग्राम + रंग-पट्टिका"
msgid "HOLD SPACE / ENTER: ORIGINAL INPUT SIGNAL"
msgstr "SPACE / ENTER दबाए रखें: मूल इनपुट संकेत"
msgid "PAULA: ORIGINAL PCM + PERIOD + VOLUME (FIRST DMA PASS)"
msgstr "PAULA: मूल PCM + अवधि + आवाज़ (पहला DMA पास)"
msgid "ORIGINAL TITLE HANDOFF: RESOURCE 0x"
msgstr "मूल शीर्षक हस्तांतरण: संसाधन 0x"
msgid "ORIGINAL $20580 STREAM: +0x"
msgstr "मूल $20580 स्ट्रीम: +0x"

msgid "MODERN GRAPHICS SETTINGS"
msgstr "आधुनिक ग्राफ़िक्स सेटिंग्स"

msgid "F10: CLOSE"
msgstr "F10: बंद करें"

msgid "LEFT/RIGHT: CHANGE"
msgstr "बायाँ/दायाँ: बदलें"

msgid "SMOOTH SCALING"
msgstr "मुलायम स्केलिंग"

msgid "PIXEL RECONSTRUCTION"
msgstr "पिक्सेल पुनर्निर्माण"

msgid "SCALE2X (MEMORY ONLY)"
msgstr "SCALE2X (केवल मेमोरी)"

msgid "OFF (ORIGINAL PIXELS)"
msgstr "बंद (मूल पिक्सेल)"

msgid "SCANLINES"
msgstr "स्कैनलाइनें"

msgid "MODERN FRAME"
msgstr "आधुनिक फ़्रेम"

msgid "ON"
msgstr "चालू"

msgid "OFF"
msgstr "बंद"

msgid "SETTINGS APPLY TO SDL RENDERING ONLY."
msgstr "सेटिंग्स केवल SDL रेंडरिंग पर लागू होती हैं।"

msgid "UP/DOWN: SELECT   LEFT/RIGHT: CHANGE   F10: CLOSE"
msgstr "ऊपर/नीचे: चुनें   बायाँ/दायाँ: बदलें   F10: बंद करें"

msgid "CLICK A GAME CARD OR USE LEFT/RIGHT, THEN ENTER"
msgstr "गेम कार्ड पर क्लिक करें या बायाँ/दायाँ दबाएँ, फिर एंटर दबाएँ"
msgid "SELECT A GAME"
msgstr "गेम चुनें"
msgid "SELECT A VERIFIED PLATFORM"
msgstr "सत्यापित प्लेटफ़ॉर्म चुनें"
msgid "UNAVAILABLE PLATFORM CARDS CANNOT START A GAME"
msgstr "अनुपलब्ध प्लेटफ़ॉर्म कार्ड गेम शुरू नहीं कर सकते"
msgid "SELECT A PRESENTATION PROFILE"
msgstr "प्रस्तुति प्रोफ़ाइल चुनें"
msgid "ORIGINAL AND MODERN START DIRECTLY. CUSTOM TUNES MODERN FIRST."
msgstr "मूल और आधुनिक सीधे शुरू होते हैं। अनुकूलित पहले आधुनिक को समायोजित करता है।"
msgid "CUSTOM SETTINGS READY — ENTER / CLICK TO START MODERN"
msgstr "अनुकूलित सेटिंग्स तैयार हैं — आधुनिक शुरू करने के लिए एंटर / क्लिक करें"

msgid "ORIGINAL"
msgstr "मूल"
msgid "PRESERVATION PROFILE"
msgstr "संरक्षण प्रोफ़ाइल"
msgid "MODERN"
msgstr "आधुनिक"
msgid "ENHANCED PROFILE"
msgstr "उन्नत प्रोफ़ाइल"
msgid "CUSTOM"
msgstr "अनुकूलित"
msgid "TUNE MODERN SETTINGS"
msgstr "आधुनिक सेटिंग्स समायोजित करें"

msgid "MILLENNIUM 2.2"
msgstr "MILLENNIUM 2.2"
msgid "RETURN TO EARTH"
msgstr "पृथ्वी पर वापसी"
msgid "DEUTEROS"
msgstr "DEUTEROS"
msgid "THE NEXT MILLENNIUM"
msgstr "अगली सहस्राब्दी"
msgid "DOS"
msgstr "DOS"
msgid "AMIGA"
msgstr "AMIGA"
msgid "ATARI ST"
msgstr "ATARI ST"
