msgstr "MANTÉN ESPACIO / INTRO: SEÑAL DE ENTRADA ORIGINAL"
msgid "PAULA: ORIGINAL PCM + PERIOD + VOLUME (FIRST DMA PASS)"
msgstr "PAULA: PCM, PERIODO Y VOLUMEN ORIGINALES (PRIMER PASE DMA)"
msgid "ORIGINAL TITLE HANDOFF: RESOURCE 0x"
msgstr "TRANSFERENCIA ORIGINAL DEL TÍTULO: RECURSO 0x"
