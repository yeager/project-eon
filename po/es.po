msgstr "PULSA CUALQUIER TECLA: TRANSFERENCIA ORIGINAL DEL TÍTULO INT 21h/AH=06h"
msgid "RECOVERED POSITIONAL WORDS ONLY; NO INFERRED GAME SEMANTICS"
msgstr "SOLO PALABRAS POSICIONALES RECUPERADAS; SIN SEMÁNTICA DEL JUEGO INFERIDA"
msgid "VERIFIED NATIVE MILLENNIUM DATA - NO DOS RESOURCE SUBSTITUTION"
msgstr "DATOS NATIVOS DE MILLENNIUM VERIFICADOS - SIN SUSTITUCIÓN DE RECURSOS DE DOS"
msgid "INTERACTIVE AMIGA/ATARI ST FLOW IS NOT YET RECOVERED."
msgstr "EL FLUJO INTERACTIVO DE AMIGA/ATARI ST AÚN NO SE HA RECUPERADO."
