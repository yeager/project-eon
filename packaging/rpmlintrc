# Project Eon CI builds non-release RPM artifacts. Releases are maintainer-only,
# so manufacturing a CI signing identity would misrepresent their provenance.
addFilter("no-signature$")

# CPack provides Vendor and Contact package metadata but has no Packager header
# field. Keep those truthful headers instead of maintaining a forked generated
# spec solely to duplicate them.
addFilter("no-packager-tag$")

# MIT is Project Eon's SPDX license identifier. Ubuntu 24.04's rpmlint 2.5
# license table rejects it even though current RPM policy accepts the SPDX form.
addFilter("invalid-license MIT$")
